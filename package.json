{
  "name": "qq-bot-v2",
  "version": "1.0.0",
  "description": "QQ / 飞书单 Agent 永续运行平台",
  "type": "module",
  "scripts": {
    "dev": "tsx src/platform.ts --watch",
    "dev:once": "tsx src/platform.ts",
    "dev:all": "tsx src/platform.ts --watch --web",
    "dev:all:once": "tsx src/platform.ts --web",
    "agent:dev": "tsx watch src/index.ts",
    "agent:dev:once": "tsx src/index.ts",
    "qq:gateway": "tsx src/services/qq-gateway.ts",
    "feishu:gateway": "tsx src/services/feishu-gateway.ts",
    "media:worker": "tsx src/services/media-worker.ts",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck && pnpm repo-check",
    "repo-check": "tsx scripts/repo-check.ts",
    "web:dev": "pnpm --filter @qq-bot/admin-web dev",
    "web:test": "pnpm --filter @qq-bot/admin-web test",
    "web:typecheck": "pnpm --filter @qq-bot/admin-web typecheck",
    "web:build": "pnpm --filter @qq-bot/admin-web build",
    "agent:doctor": "tsx scripts/agent-doctor.ts",
    "agent:metrics": "tsx scripts/agent-metrics.ts",
    "agent:daily-metrics": "tsx scripts/agent-daily-metrics.ts",
    "agent:memory-check": "tsx scripts/agent-memory-check.ts",
    "agent:ledger-check": "tsx scripts/agent-ledger-check.ts",
    "bench:ledger-commit": "tsx scripts/benchmark-ledger-commit.ts",
    "agent:context": "tsx scripts/agent-context.ts",
    "agent:reset-state": "tsx scripts/reset-agent-state.ts --confirm",
    "start": "node dist/platform.js",
    "agent:start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:query": "tsx scripts/agent-db-query.ts",
    "test": "tsx --test --test-concurrency=4 --import ./scripts/test-env.mjs --import tsx 'src/**/*.test.ts'",
    "peek": "tsx scripts/peek.ts",
    "browser:controller": "tsx scripts/browser-controller.ts",
    "toollog": "tail -n 50 logs/tool-calls.ndjson"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@tavily/core": "^0.7.2",
    "cheerio": "^1.2.0",
    "cloakbrowser": "^0.4.3",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "^5.7.2",
    "jsonrepair": "^3.13.3",
    "mmdb-lib": "^3.0.2",
    "node-napcat-ts": "^0.4.21",
    "openai": "^6.31.0",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "playwright-core": "^1.60.0",
    "sharp": "^0.34.5",
    "yaml": "^2.8.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "prisma": "^7.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
