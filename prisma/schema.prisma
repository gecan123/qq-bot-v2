generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// QQ + 飞书共享的追加式聊天事实账本。
/// eventKind = message | edit | recall；同一平台事件通过 eventExternalId 幂等。
/// resolvedText 只允许媒体描述 worker 在为空时冻结一次。
model Message {
  rowId                  Int       @id @default(autoincrement()) @map("row_id")
  eventKind              String    @map("event_kind") @db.VarChar(16)
  eventExternalId        String    @map("event_external_id") @db.VarChar(255)
  platform               String    @db.VarChar(16)
  accountId              String    @map("account_id") @db.VarChar(191)
  conversationKind       String    @map("conversation_kind") @db.VarChar(16)
  conversationExternalId String    @map("conversation_external_id") @db.VarChar(255)
  conversationName       String?   @map("conversation_name") @db.VarChar(255)
  mediaReferenceIds      String[]  @default([]) @map("media_reference_ids")
  messageExternalId      String    @map("message_external_id") @db.VarChar(255)
  replyToExternalId      String?   @map("reply_to_external_id") @db.VarChar(255)
  rootExternalId         String?   @map("root_external_id") @db.VarChar(255)
  threadExternalId       String?   @map("thread_external_id") @db.VarChar(255)
  senderExternalId       String    @map("sender_external_id") @db.VarChar(255)
  senderName             String?   @map("sender_name") @db.VarChar(100)
  senderConversationName String?   @map("sender_conversation_name") @db.VarChar(100)
  content                Json      @map("content")
  rawContent             Json?     @map("raw_content")
  rawMessage             String?   @map("raw_message") @db.Text
  searchText             String    @default("") @map("search_text") @db.Text
  resolvedText           String?   @map("resolved_text") @db.Text
  sentAt                 DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([platform, accountId, eventExternalId])
  @@index([platform, accountId, conversationKind, conversationExternalId, rowId])
  @@index([platform, accountId, messageExternalId, rowId])
  @@index([platform, accountId, senderExternalId, rowId])
  @@map("messages")
}

/// 一次入站附件或持久图片 handle。blobId 在异步下载完成前允许为空。
model Media {
  mediaId        Int        @id @default(autoincrement()) @map("media_id")
  blobId         Int?       @map("blob_id")
  mediaType      String?    @map("media_type")
  contentType    String?    @map("content_type")
  fileName       String?    @map("file_name")
  fileSize       Int?       @map("file_size")
  /// 保存本次附件的解析结果，或无 blob 时的状态说明。
  descriptionRaw Json?      @map("description_raw")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  blob           MediaBlob? @relation(fields: [blobId], references: [blobId], onDelete: Restrict)

  @@index([blobId])
  @@map("media")
}

/// 按 SHA-256 内容寻址的物理媒体数据；多个 Media 行共享同一个 blob。
model MediaBlob {
  blobId    Int      @id @default(autoincrement()) @map("blob_id")
  dataHash  String   @unique @map("data_hash") @db.VarChar(64)
  data      Bytes    @map("data")
  byteSize  Int      @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  touchedAt DateTime @default(now()) @map("touched_at") @db.Timestamptz(3)
  media     Media[]

  @@map("media_blobs")
}

/// LLM 历史的 canonical append-only ledger。运行时只允许追加，不更新或删除旧 entry。
model BotAgentLedgerEntry {
  id        BigInt   @id @default(autoincrement())
  entryType String   @map("entry_type")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entryType, id])
  @@map("bot_agent_ledger_entries")
}

/// 非 LLM 历史的单例控制状态。和可见事实一起变化时，必须与 ledger append 同事务。
model BotAgentRuntimeState {
  id                     Int       @id
  schemaVersion          Int       @map("schema_version")
  mailboxCursors         Json      @map("mailbox_cursors")
  inboxReadCursors       Json      @map("inbox_read_cursors")
  mailboxContinuity      Json      @map("mailbox_continuity")
  conversationFocus      Json?     @map("conversation_focus")
  lastWakeAt             DateTime? @map("last_wake_at") @db.Timestamptz(6)
  ledgerHeadEntryId      BigInt?   @map("ledger_head_entry_id")
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bot_agent_runtime_state")
}

/// 当前 ledger projection 的可重建启动缓存；不是历史事实来源。
model BotAgentCheckpoint {
  id             Int      @id
  schemaVersion  Int      @map("schema_version")
  throughEntryId BigInt?  @map("through_entry_id")
  fingerprint    String
  projection     Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bot_agent_checkpoint")
}

/// Luna 的表情包收藏池。collect_sticker 工具写入, compaction 后注入摘要进 context。
/// mediaId 唯一 (一张图在池子里只有一个条目), 逻辑引用 Media 表的 mediaId。
model StickerPool {
  id          Int       @id @default(autoincrement())
  mediaId     Int       @unique @map("media_id")
  name        String    @db.VarChar(50)
  tags        String[]  @default([])
  description String    @db.Text
  useCount    Int       @default(0) @map("use_count")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([useCount(sort: Desc), createdAt(sort: Desc)])
  @@map("sticker_pool")
}

/// Agent 工具调用观测事件。运行时写入失败不能影响 bot 行为; 查询侧按需聚合。
model AgentToolCall {
  id          BigInt   @id @default(autoincrement())
  ts          DateTime @db.Timestamptz(3)
  toolCallId  String   @map("tool_call_id") @db.VarChar(191)
  toolName    String   @map("tool_name") @db.VarChar(191)
  roundIndex  Int      @map("round_index")
  argsSummary Json     @map("args_summary")
  durationMs  Int      @map("duration_ms")
  ok          Boolean
  sideEffect  Boolean  @map("side_effect")
  error       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ts(sort: Desc)])
  @@index([toolName, ts(sort: Desc)])
  @@index([ok, ts(sort: Desc)])
  @@index([sideEffect, ts(sort: Desc)])
  @@map("agent_tool_calls")
}

/// 一次 LLM 调用的只读观测事件。evidence 只保存结构摘要和指纹，不保存 prompt/response 正文。
model AgentTokenUsage {
  id           BigInt   @id @default(autoincrement())
  ts           DateTime @db.Timestamptz(3)
  callId       String?  @unique @map("call_id") @db.Uuid
  operation    String   @db.VarChar(64)
  actor        String?  @db.VarChar(64)
  roundIndex   Int?     @map("round_index")
  provider     String?  @db.VarChar(64)
  status       String   @default("succeeded") @db.VarChar(32)
  durationMs   Int?     @map("duration_ms")
  stopReason   String?  @map("stop_reason") @db.VarChar(64)
  errorKind    String?  @map("error_kind") @db.VarChar(191)
  taskId       String?  @map("task_id") @db.VarChar(191)
  attempt      Int?
  model        String   @db.VarChar(191)
  inputTokens  Int?     @map("input_tokens")
  cachedTokens Int?     @map("cached_tokens")
  outputTokens Int?     @map("output_tokens")
  cacheHitRate Float?   @map("cache_hit_rate")
  evidence     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ts(sort: Desc)])
  @@index([operation, ts(sort: Desc)])
  @@index([model, ts(sort: Desc)])
  @@index([actor, ts(sort: Desc)])
  @@index([provider, ts(sort: Desc)])
  @@index([status, ts(sort: Desc)])
  @@map("agent_token_usage")
}

/// 本地 Crypto 模拟仓唯一账户。只使用 Moomoo 行情，不连接 Crypto 交易接口。
/// generation 每次 reset 递增；历史订单保留，当前持仓会清空。
model CryptoPaperAccount {
  id          Int      @id @default(1)
  currency    String   @default("USD") @db.VarChar(16)
  initialCash Decimal  @map("initial_cash") @db.Decimal(36, 12)
  cash        Decimal  @db.Decimal(36, 12)
  realizedPnl Decimal  @default(0) @map("realized_pnl") @db.Decimal(36, 12)
  feeRateBps  Int      @map("fee_rate_bps")
  generation  Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  positions CryptoPaperPosition[]
  orders    CryptoPaperOrder[]

  @@map("crypto_paper_accounts")
}

/// 当前 generation 的 Crypto 模拟持仓。averageCost 包含买入手续费。
model CryptoPaperPosition {
  id          BigInt   @id @default(autoincrement())
  accountId   Int      @map("account_id")
  symbol      String   @db.VarChar(32)
  quantity    Decimal  @db.Decimal(36, 18)
  averageCost Decimal  @map("average_cost") @db.Decimal(36, 18)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account CryptoPaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
  @@map("crypto_paper_positions")
}

/// append-only Crypto 模拟成交账本。clientOrderId 防止 LLM/tool retry 重复成交。
model CryptoPaperOrder {
  id                    BigInt   @id @default(autoincrement())
  clientOrderId         String   @unique @map("client_order_id") @db.VarChar(64)
  accountId             Int      @map("account_id")
  generation            Int
  symbol                String   @db.VarChar(32)
  side                  String   @db.VarChar(8)
  quantity              Decimal  @db.Decimal(36, 18)
  price                 Decimal  @db.Decimal(36, 18)
  notional              Decimal  @db.Decimal(36, 12)
  fee                   Decimal  @db.Decimal(36, 12)
  realizedPnl           Decimal  @map("realized_pnl") @db.Decimal(36, 12)
  cashAfter             Decimal  @map("cash_after") @db.Decimal(36, 12)
  positionQuantityAfter Decimal  @map("position_quantity_after") @db.Decimal(36, 18)
  status                String   @default("FILLED") @db.VarChar(16)
  quoteTime             DateTime? @map("quote_time") @db.Timestamptz(3)
  note                  String?  @db.VarChar(200)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  account CryptoPaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, generation, createdAt(sort: Desc)])
  @@index([symbol, createdAt(sort: Desc)])
  @@map("crypto_paper_orders")
}
